<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/homepage_background">

        <!-- Hero Section -->
        <LinearLayout
            android:id="@+id/hero_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ev_gradient_background"
            android:padding="32dp"
            android:gravity="center"
            android:minHeight="400dp">

            <ImageView
                android:id="@+id/iv_hero_logo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_launcher_foreground"
                android:layout_marginBottom="24dp"
                android:contentDescription="EV Charging App Logo" />

            <TextView
                android:id="@+id/tv_hero_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Charge Your Future"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textAlignment="center"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_hero_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Discover, book, and charge your electric vehicle at thousands of stations nationwide"
                android:textSize="18sp"
                android:textColor="@color/hero_text_secondary"
                android:textAlignment="center"
                android:layout_marginBottom="32dp"
                android:lineSpacingExtra="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_get_started"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:text="Start Charging"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/cta_button"
                android:textColor="@android:color/white"
                app:cornerRadius="28dp"
                app:elevation="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_hero_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join 50,000+ happy drivers"
                android:textSize="14sp"
                android:textColor="@color/hero_text_secondary"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Features Section -->
        <LinearLayout
            android:id="@+id/features_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@android:color/white">

            <TextView
                android:id="@+id/tv_features_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Why Choose Our Platform?"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_features_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Everything you need for seamless EV charging experience"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:textAlignment="center"
                android:layout_marginBottom="32dp" />

            <!-- Features Grid - Redesigned with better proportions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp">

                <!-- Row 1 - Improved card design -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp"
                    android:baselineAligned="false">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_find_stations"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/feature_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <!-- Icon container with background -->
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/ev_icon_background"
                                android:layout_marginBottom="12dp">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_charging_station"
                                    android:layout_gravity="center"
                                    android:contentDescription="Find Stations"
                                    android:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Find Stations"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textAlignment="center"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Locate nearby charging stations instantly"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:textAlignment="center"
                                android:lineSpacingExtra="1dp"
                                android:maxLines="2"
                                android:ellipsize="end" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_quick_booking"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/feature_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <!-- Icon container with background -->
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/ev_icon_background"
                                android:layout_marginBottom="12dp">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_booking_calendar"
                                    android:layout_gravity="center"
                                    android:contentDescription="Quick Booking"
                                    android:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Quick Booking"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textAlignment="center"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Reserve your spot in seconds"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:textAlignment="center"
                                android:lineSpacingExtra="1dp"
                                android:maxLines="2"
                                android:ellipsize="end" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Row 2 - Improved card design -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_real_time"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/feature_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <!-- Icon container with background -->
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/ev_icon_background"
                                android:layout_marginBottom="12dp">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_real_time_status"
                                    android:layout_gravity="center"
                                    android:contentDescription="Real-time Status"
                                    android:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Real-time Status"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textAlignment="center"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Live availability and pricing updates"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:textAlignment="center"
                                android:lineSpacingExtra="1dp"
                                android:maxLines="2"
                                android:ellipsize="end" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_qr_scanner"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/feature_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp">

                            <!-- Icon container with background -->
                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/ev_icon_background"
                                android:layout_marginBottom="16dp">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_qr_code"
                                    android:layout_gravity="center"
                                    android:contentDescription="QR Scanner"
                                    android:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="QR Scanner"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textAlignment="center"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Scan to start charging instantly"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:textAlignment="center"
                                android:lineSpacingExtra="1dp"
                                android:maxLines="2"
                                android:ellipsize="end" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Uniqueness Section -->
        <LinearLayout
            android:id="@+id/uniqueness_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/uniqueness_bg"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_unique_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What Makes Us Different"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAlignment="center"
                android:layout_marginBottom="32dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="⚡"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lightning Fast Booking"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Book your charging slot in under 30 seconds"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🌍"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nationwide Coverage"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10,000+ charging stations across the country"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🔒"
            android:textSize="20sp"
                        android:gravity="center"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Secure &amp; Reliable"
                            android:textSize="16sp"
            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bank-grade security and 99.9% uptime guarantee"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Visual Showcase Section -->
        <LinearLayout
            android:id="@+id/showcase_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_showcase_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="See It In Action"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_showcase_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Experience the seamless EV charging workflow"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:textAlignment="center"
                android:layout_marginBottom="32dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iv_app_demo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_launcher_background"
                    android:scaleType="centerCrop"
                    android:contentDescription="App Demo Screenshot" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#4C000000"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/lavender_round"
                        android:layout_marginBottom="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱"
                            android:textSize="40sp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interactive Demo"
                        android:textSize="20sp"
                android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to explore features"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:alpha="0.9" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_watch_demo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Watch Demo"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_gradient"
                android:textColor="@color/primary_gradient" />

        </LinearLayout>

        <!-- Testimonials Section -->
        <LinearLayout
            android:id="@+id/testimonials_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/testimonials_bg"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_testimonials_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What Drivers Say"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAlignment="center"
                android:layout_marginBottom="32dp" />

            <!-- Testimonial 1 - Improved Design -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐⭐⭐⭐⭐"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sarah M."
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textAlignment="textEnd"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="&quot;This app has completely changed how I plan my EV trips. Finding and booking charging stations is now effortless!&quot;"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="italic"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Testimonial 2 - Improved Design -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐⭐⭐⭐⭐"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mike R."
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textAlignment="textEnd"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="&quot;Fast, reliable, and user-friendly. The QR code feature is genius - just scan and charge!&quot;"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="italic"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join thousands of satisfied customers"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_gradient"
                android:textAlignment="center"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <!-- Closing CTA Section -->
        <LinearLayout
            android:id="@+id/closing_cta_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ev_gradient_background"
            android:padding="32dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_cta_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to Power Your Journey?"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_cta_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join thousands of EV drivers charging smarter"
                android:textSize="18sp"
                android:textColor="@color/hero_text_secondary"
                android:textAlignment="center"
                android:layout_marginBottom="32dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_dashboard"
                    android:layout_width="160dp"
                android:layout_height="56dp"
                android:text="View Dashboard"
                android:textSize="16sp"
                android:textStyle="bold"
                    android:backgroundTint="@color/cta_button"
                    android:textColor="@android:color/white"
                    app:cornerRadius="28dp"
                    app:elevation="8dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_find_stations"
                    android:layout_width="160dp"
                    android:layout_height="56dp"
                    android:text="Find Stations"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@android:color/white"
                    android:textColor="@android:color/white"
                    app:cornerRadius="28dp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free to use • No hidden fees • Secure payments"
                android:textSize="14sp"
                android:textColor="@color/hero_text_secondary"
                android:textAlignment="center"
                android:layout_marginTop="20dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>