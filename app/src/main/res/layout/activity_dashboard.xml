<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Good Morning, User!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="20dp" />

    <!-- EV Owner Statistics (Hidden for Station Operators) -->
    <LinearLayout
        android:id="@+id/cardPendingReservations"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:background="@drawable/white_box"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending Reservations"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_orange_dark" />

        <TextView
            android:id="@+id/tvPendingCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_orange_dark" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardApprovedReservations"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:background="@drawable/white_box"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Approved Reservations"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark" />

        <TextView
            android:id="@+id/tvApprovedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick Actions"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Station Management / Finding -->
    <Button
        android:id="@+id/btnViewNearbyStations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Nearby Charging Stations"
        android:background="@drawable/lavender_round"
        android:textColor="@android:color/white"
        android:layout_marginBottom="8dp" />

    <!-- EV Owner Features -->
    <Button
        android:id="@+id/btnCreateBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create New Booking"
        android:background="@drawable/lavender_round"
        android:textColor="@android:color/white"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnViewMyBookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View My Bookings"
        android:background="@drawable/lavender_round"
        android:textColor="@android:color/white"
        android:layout_marginBottom="8dp" />

    <!-- Station Operator Features -->
    <Button
        android:id="@+id/btnQRScanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QR Code Scanner (Operator)"
        android:background="@drawable/lavender_round"
        android:textColor="@android:color/white"
        android:visibility="gone" />

</LinearLayout>