<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create New Reservation"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <!-- Map View -->
        <LinearLayout
            android:id="@+id/layoutMapContainer"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/white_box"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Map Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Charging Station Location"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:padding="12dp"
                android:gravity="center"
                android:background="@color/design_default_color_primary" />

            <!-- Map Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="8dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Map Controls Overlay -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:orientation="vertical">

                    <!-- My Location Button -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabMyLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:src="@drawable/ic_my_location"
                        android:contentDescription="My Location"
                        app:fabSize="mini"
                        app:backgroundTint="@color/design_default_color_primary"
                        app:tint="@color/white" />

                    <!-- Zoom In Button -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabZoomIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:src="@drawable/ic_zoom_in"
                        android:contentDescription="Zoom In"
                        app:fabSize="mini"
                        app:backgroundTint="@color/white"
                        app:tint="@color/design_default_color_primary" />

                    <!-- Zoom Out Button -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabZoomOut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_zoom_out"
                        android:contentDescription="Zoom Out"
                        app:fabSize="mini"
                        app:backgroundTint="@color/white"
                        app:tint="@color/design_default_color_primary" />

                </LinearLayout>

                <!-- Map Center Indicator -->
                <View
                    android:id="@+id/mapCenterIndicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/map_center_indicator"
                    android:visibility="visible" />

            </FrameLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutStationId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_map"
            app:endIconContentDescription="Open Map">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStationId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Station ID"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReservationDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Reservation Date"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get Available Time Slots"
            android:layout_marginBottom="16dp"
            android:textColor="@color/button_text_light"
            android:backgroundTint="@color/design_default_color_primary"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutSelectedSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSelectedSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Selected Time Slot"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Reservation"
            android:layout_marginBottom="16dp"
            android:textColor="@color/button_text_light"
            android:backgroundTint="@color/button_success"
            style="@style/Widget.MaterialComponents.Button" />

        <LinearLayout
            android:id="@+id/layoutBookingSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking Summary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking ID: -"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvStationId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Station ID: -"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvReservationDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date &amp; Time: -"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvBookingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: -"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateBooking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Update"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/button_text_light"
                    android:backgroundTint="@color/button_primary"
                    style="@style/Widget.MaterialComponents.Button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelBooking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/button_text_light"
                    android:backgroundTint="@color/button_danger"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewQRCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View QR Code"
                android:layout_marginTop="8dp"
                android:textColor="@color/button_text_light"
                android:backgroundTint="@color/button_warning"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>