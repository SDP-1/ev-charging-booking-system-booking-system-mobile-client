<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- QR Code scanning permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    
    <!-- Location permissions for Google Maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- OSM Map permissions -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Notification permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
        tools:replace="android:allowBackup">
        <activity
            android:name=".ui.home.Dashboard"
            android:exported="false" />
        <!-- Authentication Activities -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem" />

        <!-- User Profile Activity -->
        <activity
            android:name=".ui.profile.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
            android:parentActivityName=".MainActivity" />

        <!-- Booking Activities -->
        <activity
            android:name=".ui.booking.BookingActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
            android:parentActivityName=".MainActivity" />
            
        <activity
            android:name=".ui.booking.MyBookingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
            android:parentActivityName=".MainActivity" />
            
        <activity
            android:name=".ui.booking.QRCodeActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
            android:parentActivityName=".ui.booking.MyBookingsActivity" />

        <!-- Maps Activity -->
        <activity
            android:name=".ui.maps.NearbyStationsActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
            android:parentActivityName=".ui.home.Dashboard" />

        <!-- Station Operator QR Scanner Activity -->
        <activity
            android:name=".ui.operator.QRScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
            android:screenOrientation="portrait" />

        <!-- Station Operator Done Services Activity -->
        <activity
            android:name=".ui.operator.DoneServicesActivity"
            android:exported="false"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem"
            android:parentActivityName=".ui.home.Dashboard" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Evchargingbookingsystembookingsystem.NoActionBar">
        </activity>
    </application>

</manifest>